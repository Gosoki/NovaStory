# 复制为 .streamlit/secrets.toml 后填入真实 key 即可使用。
# 该文件已在 .gitignore，不会被提交。
#
# 正式采数时 model 必须是【带日期的快照】(如 gpt-4o-mini-2024-07-18)，
# 不能用浮动别名 gpt-4o-mini —— 别名会在采数中途被 OpenAI 重新指向新模型，
# 造成条件间的模型漂移。scripts/deploy_check.py 会检查这一点。

[[api_configs]]
name = "OpenAI · gpt-4o-mini (pinned snapshot)"
base_url = "https://api.openai.com/v1"
model = "gpt-4o-mini-2024-07-18"
api_key = ""

# 部署时务必设置强密码，否则回退到开发默认口令。
researcher_password = ""
