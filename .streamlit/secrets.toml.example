# 复制为 .streamlit/secrets.toml 后填入真实 key 即可使用。
# 该文件已在 .gitignore，不会被提交。
#
# 【模型选型】开发/测试 = gpt-4o-mini-2024-07-18；**正式采数 = gpt-5.4-mini-2026-03-17**。
#   被试实际用的是 api_configs 的第一位，公开采数前把 FORMAL 那块移到最前面。
#   选型依据（真实 prompt 实测，2026-08-03）→ docs/paper/02 §8。
# 【必须钉日期快照】不能用浮动别名（gpt-4o-mini / gpt-5.4-mini）——别名会在采数中途被
#   OpenAI 重新指向新模型，造成条件间的模型漂移。scripts/deploy_check.py 会检查这一点。

[[api_configs]]
name = "OpenAI · gpt-4o-mini (dev / pinned snapshot)" 
base_url = "https://api.openai.com/v1"
model = "gpt-4o-mini-2024-07-18"
api_key = ""

[[api_configs]]
name = "OpenAI · gpt-5.4-mini (FORMAL / pinned snapshot)"
base_url = "https://api.openai.com/v1"
model = "gpt-5.4-mini-2026-03-17"
api_key = ""

# 部署时务必设置强密码，否则回退到开发默认口令。
researcher_password = ""
